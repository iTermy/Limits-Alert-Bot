    {
      "id": 8,
      "title": "MT5 queries and polling",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 25,
        "w": 24,
        "h": 1
      }
    },
    {
      "id": 9,
      "title": "MT5 tick query duration",
      "type": "timeseries",
      "description": "ICMarkets: every completed symbol_info_tick call. Exness: changed-price samples only. Local terminal API time; not broker network round trip.",
      "datasource": {
        "type": "prometheus",
        "uid": "limits-prometheus"
      },
      "targets": [
        {
          "refId": "0.5",
          "expr": "histogram_quantile(0.5, sum by (le, feed) (rate(limits_mt5_query_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{feed}}"
        },
        {
          "refId": "0.95",
          "expr": "histogram_quantile(0.95, sum by (le, feed) (rate(limits_mt5_query_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{feed}}"
        },
        {
          "refId": "0.99",
          "expr": "histogram_quantile(0.99, sum by (le, feed) (rate(limits_mt5_query_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{feed}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 10,
      "title": "MT5 executor duration",
      "type": "timeseries",
      "description": "ICMarkets executor queue wait plus call duration. Poll sweep includes all subscribed symbols. Includes errors and cancellations.",
      "datasource": {
        "type": "prometheus",
        "uid": "limits-prometheus"
      },
      "targets": [
        {
          "refId": "0.5",
          "expr": "histogram_quantile(0.5, sum by (le, operation) (rate(limits_mt5_call_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "refId": "0.95",
          "expr": "histogram_quantile(0.95, sum by (le, operation) (rate(limits_mt5_call_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 {{operation}}"
        },
        {
          "refId": "0.99",
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(limits_mt5_call_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p99 {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 26,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 11,
      "title": "TP / BE reaction time",
      "type": "row",
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 34,
        "w": 24,
        "h": 1

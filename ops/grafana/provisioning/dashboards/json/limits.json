    {
      "id": 12,
      "title": "Tick to confirmed state update",
      "type": "timeseries",
      "description": "From local stream manager dispatch to confirmed TP/BE database update. Includes earlier subscribers and signals on the same tick.",
      "datasource": {
        "type": "prometheus",
        "uid": "limits-prometheus"
      },
      "targets": [
        {
          "refId": "0.5",
          "expr": "histogram_quantile(0.5, sum by (le, event) (rate(limits_reaction_seconds_bucket{stage=\"state_committed\"}[$__rate_interval])))",
          "legendFormat": "p50 {{event}}"
        },
        {
          "refId": "0.95",
          "expr": "histogram_quantile(0.95, sum by (le, event) (rate(limits_reaction_seconds_bucket{stage=\"state_committed\"}[$__rate_interval])))",
          "legendFormat": "p95 {{event}}"
        },
        {
          "refId": "0.99",
          "expr": "histogram_quantile(0.99, sum by (le, event) (rate(limits_reaction_seconds_bucket{stage=\"state_committed\"}[$__rate_interval])))",
          "legendFormat": "p99 {{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 0,
        "y": 35,
        "w": 12,
        "h": 8
      }
    },
    {
      "id": 13,
      "title": "Tick to Discord delivery",
      "type": "timeseries",
      "description": "From local tick dispatch to successful critical notification return, including asynchronous delivery retries. No broker execution timing.",
      "datasource": {
        "type": "prometheus",
        "uid": "limits-prometheus"
      },
      "targets": [
        {
          "refId": "0.5",
          "expr": "histogram_quantile(0.5, sum by (le, event) (rate(limits_reaction_seconds_bucket{stage=\"discord_delivered\"}[$__rate_interval])))",
          "legendFormat": "p50 {{event}}"
        },
        {
          "refId": "0.95",
          "expr": "histogram_quantile(0.95, sum by (le, event) (rate(limits_reaction_seconds_bucket{stage=\"discord_delivered\"}[$__rate_interval])))",
          "legendFormat": "p95 {{event}}"
        },
        {
          "refId": "0.99",
          "expr": "histogram_quantile(0.99, sum by (le, event) (rate(limits_reaction_seconds_bucket{stage=\"discord_delivered\"}[$__rate_interval])))",
          "legendFormat": "p99 {{event}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "gridPos": {
        "x": 12,
        "y": 35,
        "w": 12,
        "h": 8
      }
